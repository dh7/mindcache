{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "mindcache": ["./packages/mindcache/src/index.ts"],
      "mindcache/server": ["./packages/mindcache/src/server.ts"]
    }
  },
  "include": ["src/**/*"]
}
